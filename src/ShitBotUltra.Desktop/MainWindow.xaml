<Window
    x:Class="shitbotteam.ultra.desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Grid>
        <controls:NavigationView
            x:Name="RootNavigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="OnNavigationSelectionChanged">
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem x:Name="DashboardItem" Content="{x:Bind I18n.Text('Overview'), Mode=OneWay}" Tag="overview">
                    <controls:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="{x:Bind I18n.Text('Connections'), Mode=OneWay}" Tag="connections">
                    <controls:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="World" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="{x:Bind I18n.Text('Configuration sections'), Mode=OneWay}" Tag="sections">
                    <controls:NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="{x:Bind I18n.Text('Configuration'), Mode=OneWay}" Tag="configuration">
                    <controls:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="{x:Bind I18n.Text('Tasks'), Mode=OneWay}" Tag="tasks">
                    <controls:NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="{x:Bind I18n.Text('Whitelist import'), Mode=OneWay}" Tag="imports">
                    <controls:NavigationViewItem.Icon><SymbolIcon Symbol="Import" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="{x:Bind I18n.Text('Templates'), Mode=OneWay}" Tag="templates">
                    <controls:NavigationViewItem.Icon><SymbolIcon Symbol="Pictures" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="{x:Bind I18n.Text('Plugins'), Mode=OneWay}" Tag="plugins">
                    <controls:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Manage" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="{x:Bind I18n.Text('Events'), Mode=OneWay}" Tag="events">
                    <controls:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="List" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="{x:Bind I18n.Text('Activity logs'), Mode=OneWay}" Tag="logs">
                    <controls:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Document" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.MenuItems>
            <controls:NavigationView.FooterMenuItems>
                <controls:NavigationViewItem Content="{x:Bind I18n.Text('Updates'), Mode=OneWay}" Tag="updates">
                    <controls:NavigationViewItem.Icon><SymbolIcon Symbol="Refresh" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="{x:Bind I18n.Text('Settings'), Mode=OneWay}" Tag="settings">
                    <controls:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </controls:NavigationView>
    </Grid>
</Window>
