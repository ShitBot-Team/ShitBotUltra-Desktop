<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- A direct dotnet run/build has no specific platform. Use the current
         .NET SDK architecture only for supported Windows hosts; an explicit
         RuntimeIdentifier or x64/ARM64 Platform always takes precedence. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And ('$(Platform)' == '' Or '$(Platform)' == 'AnyCPU' Or '$(Platform)' == 'Any CPU') And ('$(NETCoreSdkPortableRuntimeIdentifier)' == 'win-x64' Or '$(NETCoreSdkPortableRuntimeIdentifier)' == 'win-arm64')">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>shitbotteam.ultra.desktop</RootNamespace>
    <AssemblyName>ShitBotUltra.Desktop</AssemblyName>
    <ApplicationTitle>ShitBotUltra Desktop</ApplicationTitle>
    <ApplicationDescription>Native Windows host and management console for ShitBotUltra Core.</ApplicationDescription>
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <!--
    pack-windows.ps1 supplies this directory immediately before publishing a
    release. Keeping it empty for ordinary local builds avoids treating a
    generated Core host as a source-tree input.
  -->
  <ItemGroup Condition="'$(BundledReleaseAssetsPath)' != ''">
    <Content Include="$(BundledReleaseAssetsPath)\**\*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    The normal unpackaged MRT Core pipeline produces the project PRI but
    currently does not add it to dotnet publish output. The PRI contains the
    compiled XAML lookup entries required by Application.LoadComponent at
    startup. When EnableMsixTooling is enabled, Windows App SDK supplies its
    own equivalent publish target, so do not add the same PRI twice.
  -->
  <Target Name="AddUnpackagedProjectPriToPublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="_GenerateProjectPriFile"
          Condition="'$(WindowsPackageType)' == 'None' and '$(EnableMsixTooling)' != 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)"
                             Condition="'$(CopyBuildOutputToPublishDirectory)' == 'true' and Exists('$(ProjectPriFullPath)')">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
