<Page
    x:Class="shitbotteam.ultra.desktop.Views.Pages.ConfigurationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <StackPanel Spacing="4">
            <TextBlock Text="{x:Bind I18n.Text('Configuration'), Mode=OneWay}" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind I18n.Text('Edit the Core YAML source. Validation, backups and revision checks remain in Core.'), Mode=OneWay}" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{x:Bind I18n.Text(ViewModel.StatusMessage), Mode=OneWay}" TextWrapping="Wrap" />
        <TextBox
            x:Name="ConfigurationEditor"
            Grid.Row="2"
            Text="{x:Bind ViewModel.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            AcceptsReturn="True"
            TextWrapping="NoWrap"
            FontFamily="Consolas"
            FontSize="13"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <Button Content="{x:Bind I18n.Text('Load'), Mode=OneWay}" Command="{x:Bind ViewModel.LoadConfigurationCommand}" />
            <Button Content="{x:Bind I18n.Text('Discard draft and reload'), Mode=OneWay}" Click="OnReloadDiscardClicked" />
            <Button Content="{x:Bind I18n.Text('Validate'), Mode=OneWay}" Command="{x:Bind ViewModel.ValidateCommand}" />
            <Button Content="{x:Bind I18n.Text('Save'), Mode=OneWay}" Command="{x:Bind ViewModel.SaveCommand}" />
            <TextBlock Text="{x:Bind I18n.Text('Save status is shown above. A saved configuration may require a Core restart.'), Mode=OneWay}" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>
    </Grid>
</Page>
