<Page
    x:Class="shitbotteam.ultra.desktop.Views.Pages.ConfigurationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <StackPanel Spacing="4">
            <TextBlock Text="Configuration" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Edit the Core YAML source. Validation, backups and revision checks remain in Core." Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
        <TextBox
            x:Name="ConfigurationEditor"
            Grid.Row="2"
            Text="{x:Bind ViewModel.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            AcceptsReturn="True"
            TextWrapping="NoWrap"
            FontFamily="Consolas"
            FontSize="13"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <Button Content="Load" Command="{x:Bind ViewModel.LoadConfigurationCommand}" />
            <Button Content="Discard draft and reload" Click="OnReloadDiscardClicked" />
            <Button Content="Save" Command="{x:Bind ViewModel.SaveCommand}" />
            <TextBlock Text="Save status is shown above. A saved configuration may require a Core restart." VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>
    </Grid>
</Page>
