<Page
    x:Class="shitbotteam.ultra.desktop.Views.Pages.EventsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:shitbotteam.ultra.desktop.Models">
    <Grid Margin="28" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <StackPanel Spacing="4">
            <TextBlock Text="Core events" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Authenticated server-sent events. Reconnects resume from the last event ID." Opacity="0.7" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <TextBlock Text="{x:Bind ViewModel.StreamState, Mode=OneWay}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Clear" Command="{x:Bind ViewModel.ClearCommand}" />
        </Grid>
        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Events, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:CoreEventRow">
                    <Grid Margin="8,4" ColumnDefinitions="130,150,*" RowDefinitions="Auto,Auto">
                        <TextBlock Text="{x:Bind ReceivedAt}" Opacity="0.7" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Type}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Id}" HorizontalAlignment="Right" Opacity="0.6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind Summary}" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
