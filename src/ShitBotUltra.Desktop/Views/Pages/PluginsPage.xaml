<Page
    x:Class="shitbotteam.ultra.desktop.Views.Pages.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:shitbotteam.ultra.desktop.ViewModels"
    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
    <ScrollViewer>
        <StackPanel Margin="28" Spacing="12">
            <TextBlock Text="Plugins" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Import trusted local ZIP packages, inspect declarations, and grant only the capabilities and scopes you intend to allow." TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Refresh list" Command="{x:Bind ViewModel.RefreshCommand}" />
                <Button Content="Import ZIP" Click="OnImport" />
                <Button Content="Load selected" Click="OnOpen" />
            </StackPanel>
            <ListView ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}" MaxHeight="180" SelectionChanged="OnSelectionChanged">
                <ListView.ItemTemplate><DataTemplate x:DataType="models:PluginRow">
                    <StackPanel Orientation="Horizontal" Spacing="20"><TextBlock Text="{x:Bind Id}" /><TextBlock Text="{x:Bind State}" /></StackPanel>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="Loaded plugin" FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind ViewModel.CurrentId, Mode=OneWay}" />
            <TextBlock Text="Manifest, versions and status" />
            <TextBox Text="{x:Bind ViewModel.Metadata, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="160" />
            <ComboBox Header="Package revision" ItemsSource="{x:Bind ViewModel.Versions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.VersionRevision, Mode=TwoWay}" HorizontalAlignment="Stretch" />
            <TextBox Header="Configuration JSON" Text="{x:Bind ViewModel.Configuration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="120" />
            <TextBox Header="Granted capabilities and scopes JSON" Text="{x:Bind ViewModel.Grant, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="120" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Enable with these grants" Click="OnEnable" />
                <Button Content="Disable" Click="OnDisable" />
                <Button Content="Remove package" Click="OnRemove" />
            </StackPanel>
            <TextBlock Text="Plugin provider" FontSize="20" FontWeight="SemiBold" />
            <TextBox Header="Provider name" Text="{x:Bind ViewModel.ProviderName, Mode=TwoWay}" />
            <TextBox Header="Request JSON" Text="{x:Bind ViewModel.ProviderRequest, Mode=TwoWay}" AcceptsReturn="True" Height="90" />
            <Button Content="Call provider" Click="OnProvider" />
            <TextBox Header="Response" Text="{x:Bind ViewModel.ProviderResult, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Height="120" />
        </StackPanel>
    </ScrollViewer>
</Page>
