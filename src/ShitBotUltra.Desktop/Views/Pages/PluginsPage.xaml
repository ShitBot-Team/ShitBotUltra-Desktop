<Page
    x:Class="shitbotteam.ultra.desktop.Views.Pages.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:shitbotteam.ultra.desktop.ViewModels"
    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
    <ScrollViewer>
        <StackPanel Margin="28" Spacing="12">
            <TextBlock Text="{x:Bind I18n.Text('Plugins'), Mode=OneWay}" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind I18n.Text('Import trusted local ZIP packages, inspect declarations, and grant only the capabilities and scopes you intend to allow.'), Mode=OneWay}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind I18n.Text(ViewModel.StatusMessage), Mode=OneWay}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{x:Bind I18n.Text('Refresh list'), Mode=OneWay}" Command="{x:Bind ViewModel.RefreshCommand}" />
                <Button Content="{x:Bind I18n.Text('Import ZIP'), Mode=OneWay}" Click="OnImport" />
                <Button Content="{x:Bind I18n.Text('Load selected'), Mode=OneWay}" Click="OnOpen" />
            </StackPanel>
            <ListView ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}" MaxHeight="180" SelectionChanged="OnSelectionChanged">
                <ListView.ItemTemplate><DataTemplate x:DataType="models:PluginRow">
                    <StackPanel Orientation="Horizontal" Spacing="20"><TextBlock Text="{x:Bind Id}" /><TextBlock Text="{x:Bind State}" /></StackPanel>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="{x:Bind I18n.Text('Loaded plugin'), Mode=OneWay}" FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind ViewModel.CurrentId, Mode=OneWay}" />
            <TextBlock Text="{x:Bind I18n.Text('Manifest, versions and status'), Mode=OneWay}" />
            <TextBox Text="{x:Bind ViewModel.Metadata, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="160" />
            <ComboBox Header="{x:Bind I18n.Text('Package revision'), Mode=OneWay}" ItemsSource="{x:Bind ViewModel.Versions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.VersionRevision, Mode=TwoWay}" HorizontalAlignment="Stretch" />
            <TextBox Header="{x:Bind I18n.Text('Configuration JSON'), Mode=OneWay}" Text="{x:Bind ViewModel.Configuration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="120" />
            <TextBox Header="{x:Bind I18n.Text('Granted capabilities and scopes JSON'), Mode=OneWay}" Text="{x:Bind ViewModel.Grant, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="120" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{x:Bind I18n.Text('Enable with these grants'), Mode=OneWay}" Click="OnEnable" />
                <Button Content="{x:Bind I18n.Text('Disable'), Mode=OneWay}" Click="OnDisable" />
                <Button Content="{x:Bind I18n.Text('Remove package'), Mode=OneWay}" Click="OnRemove" />
            </StackPanel>
            <TextBlock Text="{x:Bind I18n.Text('Plugin provider'), Mode=OneWay}" FontSize="20" FontWeight="SemiBold" />
            <TextBox Header="{x:Bind I18n.Text('Provider name'), Mode=OneWay}" Text="{x:Bind ViewModel.ProviderName, Mode=TwoWay}" />
            <TextBox Header="{x:Bind I18n.Text('Request JSON'), Mode=OneWay}" Text="{x:Bind ViewModel.ProviderRequest, Mode=TwoWay}" AcceptsReturn="True" Height="90" />
            <Button Content="{x:Bind I18n.Text('Call provider'), Mode=OneWay}" Click="OnProvider" />
            <TextBox Header="{x:Bind I18n.Text('Response'), Mode=OneWay}" Text="{x:Bind ViewModel.ProviderResult, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Height="120" />
        </StackPanel>
    </ScrollViewer>
</Page>
