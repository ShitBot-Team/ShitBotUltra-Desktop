<Page
    x:Class="shitbotteam.ultra.desktop.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="28" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Connection details and local host paths. Admin credentials are kept in memory only." Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Core management URL" FontWeight="SemiBold" />
                <TextBox Text="{x:Bind ViewModel.Endpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="http://127.0.0.1:17880/" />
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Text="CLI executable" FontWeight="SemiBold" />
                <TextBox Text="{x:Bind ViewModel.CliExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Path to sbu.exe" />
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Text="CLI arguments" FontWeight="SemiBold" />
                <TextBox Text="{x:Bind ViewModel.CliArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Leave blank if the CLI starts Core without arguments" />
                <TextBlock Text="Desktop passes this argument string directly to sbu.exe without a shell. Use the syntax documented by your CLI version." Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Text="Core configuration directory" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.ConfigDirectory, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Text="The Core owns its database and runtime files. Desktop uses the documented default user configuration directory." Opacity="0.7" TextWrapping="Wrap" />
                <Button Content="Open configuration directory" Command="{x:Bind ViewModel.OpenConfigDirectoryCommand}" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Text="Admin token" FontWeight="SemiBold" />
                <PasswordBox x:Name="AdminTokenBox" PasswordChanged="OnPasswordChanged" PlaceholderText="Leave blank to read secrets/admin.token" />
            </StackPanel>
            <ToggleSwitch Header="Start or attach to Core when Desktop opens" IsOn="{x:Bind ViewModel.StartCoreOnLaunch, Mode=TwoWay}" />
            <ToggleSwitch Header="Minimize to the system tray when closing the window" IsOn="{x:Bind ViewModel.MinimizeToTrayOnClose, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Save preferences" Command="{x:Bind ViewModel.SaveCommand}" />
                <Button Content="Discard changes and reload" Click="OnReloadDiscardClicked" />
                <Button Content="Connect" Click="OnConnectClicked" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
