<Page
    x:Class="shitbotteam.ultra.desktop.Views.Pages.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer><StackPanel Margin="28" Spacing="12" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
        <TextBlock Text="Updates and about" FontSize="30" FontWeight="SemiBold" />
        <TextBlock Text="{x:Bind ViewModel.DesktopVersion}" />
        <TextBlock Text="ShitBot-Team and contributors · AGPL-3.0-only" />
        <TextBlock Text="The controls below manage the connected Core host through its own updater. They do not replace this Desktop installation." TextWrapping="Wrap" />
        <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" />
        <TextBlock Text="{x:Bind ViewModel.HostStatus, Mode=OneWay}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Refresh status" Command="{x:Bind ViewModel.RefreshCommand}" /><Button Content="Check host updates" Click="OnCheck" /><Button Content="Install through host" Click="OnInstall" /></StackPanel>
        <TextBlock Text="{x:Bind ViewModel.ReleaseDetails, Mode=OneWay}" TextWrapping="Wrap" />
        <TextBox Header="Release notes" Text="{x:Bind ViewModel.ReleaseNotes, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="300" />
        <TextBlock Text="The host verifies the asset and decides how to install or roll back. Refresh or reconnect to confirm the final version." TextWrapping="Wrap" />
    </StackPanel></ScrollViewer>
</Page>
