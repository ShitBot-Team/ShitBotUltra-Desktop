<Page
    x:Class="shitbotteam.ultra.desktop.Views.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:shitbotteam.ultra.desktop.Services">
    <Grid Margin="28" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <StackPanel Spacing="4">
            <TextBlock Text="Activity logs" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Desktop lifecycle and Core management-event summaries. Chat bodies and credentials are not stored." Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*,180,Auto,Auto" ColumnSpacing="8">
            <TextBox Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter source or message" />
            <ComboBox Grid.Column="1" SelectedValue="{x:Bind ViewModel.SelectedLevel, Mode=TwoWay}" SelectedValuePath="Content">
                <ComboBoxItem Content="All" />
                <ComboBoxItem Content="Information" />
                <ComboBoxItem Content="Warning" />
                <ComboBoxItem Content="Error" />
            </ComboBox>
            <Button Grid.Column="2" Content="Open log folder" Command="{x:Bind ViewModel.OpenLogDirectoryCommand}" />
            <Button Grid.Column="3" Content="Clear view" Command="{x:Bind ViewModel.ClearViewCommand}" />
        </Grid>
        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.FilteredEntries}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:DesktopLogEntry">
                    <Grid Padding="8,5" ColumnDefinitions="190,100,150,*" ColumnSpacing="10">
                        <TextBlock Text="{x:Bind TimestampText}" Opacity="0.7" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Level}" FontWeight="SemiBold" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Source}" Opacity="0.8" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Message}" TextWrapping="Wrap" VerticalAlignment="Top" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.7" TextWrapping="Wrap" />
    </Grid>
</Page>
