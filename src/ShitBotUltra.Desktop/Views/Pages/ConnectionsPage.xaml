<Page
    x:Class="shitbotteam.ultra.desktop.Views.Pages.ConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:shitbotteam.ultra.desktop.Models">
    <Grid Margin="28" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <StackPanel Spacing="4">
            <TextBlock Text="Connections" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Live node and adapter state reported by Core." Opacity="0.7" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.ConnectionState, Mode=OneWay}" />
        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.ConnectionRows, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ConnectionRow">
                    <Grid Margin="10,6" ColumnDefinitions="110,*,150" RowDefinitions="Auto,Auto">
                        <TextBlock Text="{x:Bind Category}" Opacity="0.7" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{x:Bind State}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind Details}" Opacity="0.7" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
